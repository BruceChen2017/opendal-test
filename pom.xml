<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot 2.7.18 is the final 2.7.x release and the last line that supports
    Java 8, which matters because the OpenDAL Java binding targets bytecode 1.8.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>opendal-minio-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>OpenDAL MinIO Demo</name>
  <description>
    Spring Boot web app exposing synchronous and asynchronous read/write object
    operations against MinIO using OpenDAL.
  </description>

  <properties>
    <java.version>8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      OpenDAL version. The Java binding is versioned independently of the Rust
      `opendal` crate.

      NOTE: the artifact id is `opendal`, NOT the older `opendal-java`, which
      stops at 0.46.4 and does not contain 0.49.0 or later.
    -->
    <opendal.version>0.49.0</opendal.version>

    <os-maven-plugin.version>1.7.0</os-maven-plugin.version>
  </properties>

  <build>
    <!--
      The OpenDAL Java binding is a JNI wrapper: it ships a platform-specific
      native library in a separate classifier JAR. os-maven-plugin resolves
      ${os.detected.classifier} for the current host so Maven picks the right one.
    -->
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      OpenDAL requires BOTH dependencies: the main JAR with the Java classes and
      the classifier JAR carrying the native library for this platform.

      On musl-based Linux (e.g. Alpine), os-maven-plugin does not emit a musl
      classifier, so override it explicitly, e.g.:
        mvn -Dos.detected.classifier=linux-x86_64-musl ...
    -->
    <dependency>
      <groupId>org.apache.opendal</groupId>
      <artifactId>opendal</artifactId>
      <version>${opendal.version}</version>
    </dependency>

    <dependency>
      <groupId>org.apache.opendal</groupId>
      <artifactId>opendal</artifactId>
      <version>${opendal.version}</version>
      <classifier>${os.detected.classifier}</classifier>
    </dependency>
  </dependencies>
</project>
